{
  "name": "open-excel-add-in",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental Excel add-in with ChatGPT OAuth spike and range read/write.",
  "scripts": {
    "build": "node ./node_modules/webpack/bin/webpack.js --mode production",
    "dev-server": "node ./node_modules/webpack-dev-server/bin/webpack-dev-server.js --mode development",
    "start": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "test": "node --test src/taskpane/scripts/*.test.js",
    "deploy": "npm run build && npx gh-pages -d dist",
    "predeploy": "npm run build"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "office-addin-debugging": "^6.0.7",
    "office-addin-dev-certs": "^2.0.7",
    "office-addin-manifest": "^2.1.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "gh-pages": "^6.1.1"
  },
  "homepage": "https://<username>.github.io/<repo>/"
}
